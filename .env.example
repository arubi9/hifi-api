# Tidal API Credentials
# Run tidal_auth/tidal_auth.py to generate token.json (preferred method).
# Alternatively, set these env vars directly:
CLIENT_ID=
CLIENT_SECRET=
USER_ID=
REFRESH_TOKEN=
COUNTRY_CODE=US
TOKEN_FILE=token.json

# API Security
# Set an API key to require authentication on all endpoints.
# When unset, the API is open (no auth required).
API_KEY=

# CORS Origins (comma-separated). Default: * (allow all).
# Example: https://myapp.com,https://staging.myapp.com
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO

# Bulk Download Settings
BULK_MAX_TRACKS_PER_REQUEST=500
BULK_DEFAULT_CONCURRENCY=15
BULK_MAX_CONCURRENCY=30
BULK_GLOBAL_SEMAPHORE=50
BULK_PER_CREDENTIAL_SEMAPHORE=10
BULK_MAX_RETRIES=3

# Connection Pool Settings (for high-throughput bulk operations)
HTTP_MAX_CONNECTIONS=600
HTTP_KEEPALIVE_CONNECTIONS=400

# Docker Compose: host port mapping
HOST_PORT=8000
